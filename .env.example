# Скопіюй у .env (він у .gitignore). Реальні значення в репо не комітимо.
# Токен, яким n8n пише KB у triage-сервіс:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
KB_SYNC_TOKEN=
# ID бази «IAM KB» у Notion — 32 hex з URL бази (не секрет)
NOTION_KB_DATABASE_ID=
# Необов'язково: Claude-класифікатор
# ANTHROPIC_API_KEY=

# Класифікатор сервісу: rules | llm (потрібен ANTHROPIC_API_KEY)
CLASSIFIER_MODE=rules
# ANTHROPIC_API_KEY=
# Локальна LLM на ПК з GPU (Ollama). CLASSIFIER_MODE=ollama
# OLLAMA_URL=http://192.168.1.50:11434
# OLLAMA_MODEL=qwen3:14b
